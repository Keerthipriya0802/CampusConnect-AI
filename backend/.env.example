PORT=5000
NODE_ENV=development
# MongoDB Atlas connection (optional, uncomment when using cloud database)
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.lherkvm.mongodb.net/campusconnect?retryWrites=true&w=majority
# Local MongoDB fallback (default)
MONGO_URI=mongodb://127.0.0.1:27017/campusconnect
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d
GEMINI_API_KEY=replace-with-your-gemini-key
GEMINI_MODEL=gemini-1.5-flash
UPLOAD_DIR=uploads
COORDINATOR_NAME=Placement Coordinator
COORDINATOR_EMAIL=coordinator@example.com
COORDINATOR_PASSWORD=replace-with-strong-password
TEST_LOGIN_NAME=Demo Student
TEST_LOGIN_EMAIL=student@example.com
TEST_LOGIN_PASSWORD=replace-with-strong-password
